<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/white"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:id="@+id/ivTopLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_logo"
        android:contentDescription="@string/cd_logo"
        android:padding="8dp"
        android:src="@drawable/ic_placeholder" />

    <TextView
        android:id="@+id/tvTopTitle"
        style="@style/SearchIt.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="@string/top_title"
        android:textColor="@color/purple_dark"
        android:textSize="@dimen/text_heading" />

    <TextView
        android:id="@+id/tvProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:text="@string/top_profile"
        android:textColor="@color/text_gray"
        android:textSize="@dimen/text_label" />
</LinearLayout>