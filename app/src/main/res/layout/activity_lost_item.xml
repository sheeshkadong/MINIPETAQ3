<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gray_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/tvBreadcrumb"
                style="@style/SearchIt.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lost_breadcrumb"
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/tvLostTitle"
                style="@style/SearchIt.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/lost_title"
                android:textColor="@color/purple_dark" />

            <LinearLayout
                android:id="@+id/cardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Image Upload Section -->
                <TextView
                    style="@style/SearchIt.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/btnAddImage"
                    android:text="@string/lost_image_label" />

                <LinearLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/ivItemImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_add_image"
                        android:src="@drawable/ic_placeholder" />

                    <Button
                        android:id="@+id/btnAddImage"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/lost_add_image"
                        android:textAllCaps="false"
                        android:textColor="@color/purple"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <!-- Product Name -->
                <TextView
                    style="@style/SearchIt.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:labelFor="@+id/etProductName"
                    android:text="@string/lost_name_label" />

                <EditText
                    android:id="@+id/etProductName"
                    style="@style/SearchIt.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:hint="@string/lost_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    tools:ignore="LabelFor" />

                <!-- Product Description -->
                <TextView
                    style="@style/SearchIt.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:labelFor="@+id/etProductDesc"
                    android:text="@string/lost_desc_label" />

                <EditText
                    android:id="@+id/etProductDesc"
                    style="@style/SearchIt.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:autofillHints=""
                    android:gravity="top"
                    android:hint="@string/lost_desc_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    tools:ignore="LabelFor" />

                <!-- Buttons: Cancel & Publish -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancel"
                        style="@style/SearchIt.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_cancel" />

                    <Button
                        android:id="@+id/btnPublish"
                        style="@style/SearchIt.Button.Gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:text="@string/btn_publish" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>