<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Branding -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/top_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Registration Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reg_card_title"
                android:textColor="#352052"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="@string/reg_card_subtitle"
                android:textColor="#766B80"
                android:textSize="13sp" />

            <!-- Full Name -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:labelFor="@+id/etName"
                android:text="@string/reg_label_name"
                android:textColor="#554466"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="18dp"
                android:autofillHints=""
                android:background="@drawable/bg_register_input"
                android:hint="@string/reg_hint_full_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:padding="12dp"
                android:textColor="#352052"
                android:textColorHint="#998FA2"
                tools:ignore="LabelFor" />

            <!-- Email -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:labelFor="@+id/etRegisterEmail"
                android:text="@string/reg_label_email"
                android:textColor="#554466"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="18dp"
                android:autofillHints=""
                android:background="@drawable/bg_register_input"
                android:hint="@string/reg_hint_email_input"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#352052"
                android:textColorHint="#998FA2"
                tools:ignore="LabelFor" />

            <!-- Password -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:labelFor="@+id/etRegisterPassword"
                android:text="@string/reg_label_password"
                android:textColor="#554466"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="18dp"
                android:autofillHints=""
                android:background="@drawable/bg_register_input"
                android:hint="@string/reg_hint_password_input"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#352052"
                android:textColorHint="#998FA2"
                tools:ignore="LabelFor" />

            <!-- Confirm Password -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:labelFor="@+id/etConfirmPassword"
                android:text="@string/reg_label_confirm_password"
                android:textColor="#554466"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="25dp"
                android:autofillHints=""
                android:background="@drawable/bg_register_input"
                android:hint="@string/reg_hint_confirm_password_input"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#352052"
                android:textColorHint="#998FA2"
                tools:ignore="LabelFor" />

            <!-- Register Button -->

            <Button
                android:id="@+id/btnRegister"
                style="@style/SearchIt.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/reg_btn_create"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Back to Log in -->

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/reg_back_to_login"
                android:textColor="@color/purple_dark"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>